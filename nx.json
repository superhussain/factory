{
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "shared": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/.node-version"
    ]
  },
  "targetDefaults": {
    "auth": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "{workspaceRoot}/tests/worker/access.test.mjs",
        "{workspaceRoot}/tests/worker/entry-auth.test.mjs"
      ]
    },
    "protocol": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "{workspaceRoot}/tests/worker/project-settings.test.mjs",
        "{workspaceRoot}/tests/worker/project-documents.test.mjs",
        "{workspaceRoot}/tests/worker/protocol-v1.test.mjs",
        "{workspaceRoot}/tests/worker/coverage.test.mjs",
        "{workspaceRoot}/tests/worker/lockfile.test.mjs",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/tests/worker/nx-config.test.mjs",
        "{workspaceRoot}/tests/worker/public-repo-notes.test.mjs",
        "{workspaceRoot}/docs/repo-security.md"
      ]
    },
    "assets": {
      "cache": true,
      "outputs": ["{workspaceRoot}/.build"],
      "inputs": [
        "default",
        "shared",
        "{workspaceRoot}/worker/**/*",
        "{workspaceRoot}/tools/assets.mjs",
        "{workspaceRoot}/THIRD_PARTY_NOTICES.md"
      ]
    },
    "deploy": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "{workspaceRoot}/tests/tools/**",
        "{workspaceRoot}/tests/fixtures/deployment-valid.json",
        "{workspaceRoot}/docs/cloudflare.md"
      ]
    },
    "local": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "!{workspaceRoot}/tools/deploy.mjs",
        "{workspaceRoot}/tests/support/**/*",
        "{workspaceRoot}/tests/fixtures/project-documents.md",
        "{workspaceRoot}/tests/fixtures/project-document-notes.md",
        "{workspaceRoot}/tests/fixtures/project-settings.md",
        "{workspaceRoot}/worker/**/*",
        "{workspaceRoot}/web/**/*",
        "{workspaceRoot}/tests/worker/local-http.mjs",
        "{workspaceRoot}/tests/worker/http-v1.test.mjs",
        "{workspaceRoot}/tests/worker/project-api.test.mjs",
        "{workspaceRoot}/tests/worker/project-documents-api.test.mjs",
        "{workspaceRoot}/rust/Cargo.lock",
        "{workspaceRoot}/rust/factory/**/*",
        "{workspaceRoot}/THIRD_PARTY_NOTICES.md",
        "{workspaceRoot}/.node-version"
      ]
    },
    "browser": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "!{workspaceRoot}/tools/deploy.mjs",
        "{workspaceRoot}/tests/browser/**/*",
        "{workspaceRoot}/tests/fixtures/browser-cases.json",
        "{workspaceRoot}/tests/fixtures/inbox-count.json",
        "{workspaceRoot}/tests/fixtures/project-documents.md",
        "{workspaceRoot}/tests/fixtures/project-document-notes.md",
        "{workspaceRoot}/tests/fixtures/project-settings-board.json",
        "{workspaceRoot}/tests/fixtures/hosts-list.json",
        "{workspaceRoot}/tests/fixtures/walkthrough-map.html",
        "{workspaceRoot}/tests/fixtures/walkthrough-rich.html",
        "{workspaceRoot}/tests/fixtures/retro-backlog-context.txt",
        "{workspaceRoot}/skills/factory/references/pickup.md",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tests/support/**/*",
        "{workspaceRoot}/worker/**/*",
        "{workspaceRoot}/web/**/*",
        "{workspaceRoot}/THIRD_PARTY_NOTICES.md",
        "{workspaceRoot}/.node-version",
        { "env": "FACTORY_BROWSER_SHARD" }
      ]
    },
    "verify": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "shared",
        "{workspaceRoot}/tests/tools/verify.test.mjs",
        "{workspaceRoot}/tests/tools/secret-scan.test.mjs",
        "{workspaceRoot}/tests/tools/stage-notes-check.test.mjs",
        "{workspaceRoot}/docs/repo-security.md",
        "{workspaceRoot}/.gitleaks.toml",
        { "runtime": "node --version" }
      ]
    }
  }
}
