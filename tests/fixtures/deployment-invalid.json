{
  "version": 1,
  "cases": [
    { "name": "missing audience", "remove": ["audience"], "error": "missing profile keys" },
    { "name": "unknown key", "set": { "env": "production" }, "error": "unknown profile keys" },
    { "name": "duplicate key", "raw": "{\"version\":1,\"version\":1}", "error": "duplicate key" },
    { "name": "boolean version", "set": { "version": true }, "error": "version must be the number 1" },
    { "name": "string version", "set": { "version": "1" }, "error": "version must be the number 1" },
    { "name": "short account id", "set": { "account_id": "0000" }, "error": "account_id" },
    { "name": "non-hex account id", "set": { "account_id": "g0000000000000000000000000000000" }, "error": "account_id" },
    { "name": "uppercase worker name", "set": { "worker_name": "Factory" }, "error": "worker_name" },
    { "name": "long worker name", "set": { "worker_name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "error": "worker_name" },
    { "name": "short bucket name", "set": { "bucket_name": "ab" }, "error": "bucket_name" },
    { "name": "ipv4-shaped bucket name", "set": { "bucket_name": "192.168.0.1" }, "error": "bucket_name" },
    { "name": "xn-- bucket name", "set": { "bucket_name": "xn--example-bucket" }, "error": "bucket_name" },
    { "name": "sthree bucket name", "set": { "bucket_name": "sthree-example" }, "error": "bucket_name" },
    { "name": "s3alias bucket name", "set": { "bucket_name": "factory-example-s3alias" }, "error": "bucket_name" },
    { "name": "ol-s3 bucket name", "set": { "bucket_name": "factory-example--ol-s3" }, "error": "bucket_name" },
    { "name": "http origin", "set": { "origin": "http://factory.example.test" }, "error": "origin" },
    { "name": "workers.dev origin", "set": { "origin": "https://app.workers.dev" }, "error": "workers.dev" },
    { "name": "origin with path", "set": { "origin": "https://factory.example.test/app" }, "error": "origin" },
    { "name": "origin with port", "set": { "origin": "https://factory.example.test:8443" }, "error": "origin" },
    { "name": "origin with credentials", "set": { "origin": "https://user@factory.example.test" }, "error": "origin" },
    { "name": "origin with query", "set": { "origin": "https://factory.example.test/?x=1" }, "error": "origin" },
    { "name": "wildcard origin", "set": { "origin": "https://*.example.test" }, "error": "origin" },
    { "name": "issuer wrong host", "set": { "issuer": "https://wrong.example.test" }, "error": "issuer" },
    { "name": "issuer trailing slash", "set": { "issuer": "https://example-team.cloudflareaccess.com/" }, "error": "issuer" },
    { "name": "issuer http", "set": { "issuer": "http://example-team.cloudflareaccess.com" }, "error": "issuer" },
    { "name": "empty audience", "set": { "audience": "" }, "error": "audience" },
    { "name": "long title", "set": { "title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "error": "title" },
    { "name": "placeholder angle", "set": { "worker_name": "factory-example", "title": "Factory <team>" }, "error": "placeholder" },
    { "name": "placeholder dollar", "set": { "audience": "${AUDIENCE}" }, "error": "placeholder" },
    { "name": "placeholder replace-me", "set": { "account_id": "REPLACE_ME_REPLACE_ME_REPLACE" }, "error": "placeholder" },
    { "name": "image origins not a list", "set": { "image_origins": "{}" }, "error": "image_origins" },
    { "name": "image origin duplicate", "set": { "image_origins": ["https://images.example.test", "https://images.example.test"] }, "error": "duplicates" },
    { "name": "image origin http", "set": { "image_origins": ["http://images.example.test"] }, "error": "image_origins entry" },
    { "name": "image origin port", "set": { "image_origins": ["https://images.example.test:8443"] }, "error": "image_origins entry" },
    { "name": "image origin path", "set": { "image_origins": ["https://images.example.test/x"] }, "error": "image_origins entry" },
    { "name": "agent links unknown kind", "set": { "agent_links": { "desktop": { "label": "Session", "template": "session://h/{server}/{agent}" } } }, "error": "app and web" },
    { "name": "agent link missing template", "set": { "agent_links": { "web": { "label": "Session" } } }, "error": "label and template" },
    { "name": "agent link unknown placeholder", "set": { "agent_links": { "web": { "label": "Session", "template": "https://sessions.example.test/{server}/{token}" } } }, "error": "placeholders" },
    { "name": "agent link missing agent placeholder", "set": { "agent_links": { "web": { "label": "Session", "template": "https://sessions.example.test/{server}" } } }, "error": "placeholders" },
    { "name": "web link not https", "set": { "agent_links": { "web": { "label": "Session", "template": "http://sessions.example.test/{server}/{agent}" } } }, "error": "not allowed" },
    { "name": "app link https", "set": { "agent_links": { "app": { "label": "Session", "template": "https://sessions.example.test/{server}/{agent}" } } }, "error": "non-http custom scheme" },
    { "name": "link javascript scheme", "set": { "agent_links": { "web": { "label": "Session", "template": "javascript:{server}/{agent}" } } }, "error": "not allowed" },
    { "name": "link protocol relative", "set": { "agent_links": { "web": { "label": "Session", "template": "//sessions.example.test/{server}/{agent}" } } }, "error": "protocol-relative" },
    { "name": "link credentials", "set": { "agent_links": { "web": { "label": "Session", "template": "https://u:p@sessions.example.test/{server}/{agent}" } } }, "error": "credentials" },
    { "name": "link control character", "set": { "agent_links": { "web": { "label": "Session", "template": "https://sessions.example.test/{server}/{agent}\n" } } }, "error": "control" },
    { "name": "link empty label", "set": { "agent_links": { "web": { "label": "", "template": "https://sessions.example.test/{server}/{agent}" } } }, "error": "label" },
    { "name": "jira origin not https", "set": { "jira_origin": "http://jira.example.test" }, "error": "jira_origin" }
  ]
}
